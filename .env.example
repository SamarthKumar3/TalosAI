# Safe, non-working examples only. Copy to an ignored local environment file.
TALOS_ENV=development
TALOS_PUBLIC_URL=http://localhost:3000
TALOS_API_BASE_URL=http://127.0.0.1:8000
TALOS_WEB_URL=http://127.0.0.1:3000
TALOS_WEB_API_BASE_URL=http://api:8000
TALOS_API_HOST=127.0.0.1
TALOS_API_PORT=8000
TALOS_API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TALOS_LOG_LEVEL=INFO
TALOS_REMOTE_ACCESS_ENABLED=false
TALOS_LOCAL_API_TOKEN=
TALOS_MODEL_CREDENTIALS_PATH=.talos/model-credentials
TALOS_MAX_INPUT_CHARACTERS=100000

DATABASE_URL=postgresql+asyncpg://talos:replace-me@postgres-dev:5432/talos_dev
REDIS_URL=redis://redis-dev:6379/0
TALOS_REDIS_QUEUE=talos:jobs
TALOS_WORKER_POLL_SECONDS=2
TALOS_CLI_MAX_STDIN_BYTES=1048576
TALOS_COMPOSE_FILE=docker-compose.dev.yaml
TALOS_COMPOSE_PROJECT_NAME=talos
TALOS_LOG_TAIL_LINES=200
TALOS_SHELL_RUNTIME_MODE=service
TALOS_API_STARTUP_TIMEOUT_SECONDS=120
TALOS_WEB_STARTUP_TIMEOUT_SECONDS=120
TALOS_COMPOSE_COMMAND_TIMEOUT_SECONDS=300
TALOS_COMPOSE_STOP_TIMEOUT_SECONDS=10
TALOS_ARTIFACT_ROOT=/var/lib/talos/artifacts
TALOS_LOCAL_CONFIG_PATH=talos.yaml
TALOS_CREDENTIAL_SERVICE_NAME=TalosAI
TALOS_LEGACY_CREDENTIAL_FILE_PATH=.talos/credentials.env
TALOS_HISTORY_PATH=.talos/history
TALOS_HISTORY_ENABLED=true
TALOS_PROMPT_NAME=

TALOS_PIPELINE_MANIFEST_PATH=config/pipelines/simple-chat.yaml
TALOS_PROVIDER_REGISTRY_PATH=config/providers.yaml
TALOS_MODEL_REGISTRY_PATH=config/models.yaml
TALOS_TOOL_REGISTRY_PATH=config/tools.yaml
TALOS_SKILL_REGISTRY_PATH=config/skills.yaml
TALOS_PROMPT_REGISTRY_PATH=config/prompts.yaml
TALOS_RAG_CONFIG_PATH=config/rag.yaml
TALOS_GUARDRAIL_CONFIG_PATH=config/guardrails.yaml
TALOS_CAPABILITY_REGISTRY_PATH=config/capabilities.yaml
TALOS_RELIABILITY_CONFIG_PATH=config/reliability.yaml
TALOS_SKILL_MAX_FILE_BYTES=32768

TALOS_DEFAULT_PROVIDER=openrouter
TALOS_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TALOS_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
TALOS_PROVIDER_READ_TIMEOUT_SECONDS=60

TALOS_EMBEDDING_MODEL=configure-before-rag-phase
TALOS_RERANK_MODEL=local-lexical-rerank-v1
TALOS_AGENT_MAX_STEPS=10
TALOS_MAX_TOOL_CALLS_PER_RUN=5
TALOS_MAX_TOKENS_PER_RUN=20000
TALOS_MODEL_MAX_ATTEMPTS=3
TALOS_MODEL_RETRY_BASE_MILLISECONDS=250
TALOS_MODEL_RETRY_MAX_MILLISECONDS=2000
TALOS_MODEL_RETRY_JITTER_RATIO=0.2
TALOS_MEMORY_SUMMARY_AFTER_MESSAGES=12
TALOS_MEMORY_KEEP_RECENT_MESSAGES=6
TALOS_MEMORY_MAX_SUMMARY_CHARACTERS=6000
TALOS_MEMORY_SUMMARY_STRATEGY=extractive_v1
TALOS_MEMORY_MAX_LONG_TERM_ITEMS=100
TALOS_MEMORY_MAX_CHARACTERS=1000
TALOS_AGENT_TIMEOUT_SECONDS=120
TALOS_MODEL_MAX_RETRIES=2
TALOS_MODEL_MAX_OUTPUT_TOKENS=2048
TALOS_MODEL_CONTEXT_WINDOW_TOKENS=128000
TALOS_CONTEXT_SAFETY_MARGIN_TOKENS=1024
TALOS_TOOL_TIMEOUT_SECONDS=15
TALOS_TOOL_MAX_RESPONSE_BYTES=65536
TALOS_TOOL_APPROVAL_TTL_SECONDS=600
TALOS_HTTP_TOOL_ALLOWED_DOMAINS=example.com

TALOS_RAG_CHUNK_SIZE=800
TALOS_RAG_CHUNK_OVERLAP=120
TALOS_RAG_TOP_K=6
TALOS_RAG_SIMILARITY_THRESHOLD=0.20
TALOS_LOCAL_EMBEDDING_MODEL=local-hashing-v1
TALOS_RAG_EMBEDDING_ADAPTER=talos.knowledge:HashingEmbedder
TALOS_RAG_EMBEDDING_API_BASE=https://api.openai.com/v1
TALOS_RAG_EMBEDDING_API_KEY_NAME=OPENAI_API_KEY
TALOS_RAG_EMBEDDING_TIMEOUT_SECONDS=30
TALOS_RAG_ALLOWED_EXTENSIONS=.md,.txt,.py,.rst,.pdf
TALOS_RAG_MAX_PDF_PAGES=100
TALOS_RAG_MAX_PDF_PARSE_SECONDS=15
TALOS_RAG_MAX_QUERY_CHARACTERS=2000
TALOS_RAG_EMBEDDING_DIMENSIONS=256
TALOS_RAG_MAX_SOURCE_BYTES=1048576
TALOS_RAG_MAX_CHUNKS=10000
TALOS_RAG_MAX_INGESTION_ATTEMPTS=3
TALOS_RAG_RETRY_BASE_SECONDS=2
TALOS_RAG_MODE=advanced
TALOS_RAG_QUERY_REWRITING=true
TALOS_RAG_QUERY_EXPANSION=true
TALOS_RAG_MAX_QUERY_VARIANTS=3
TALOS_RAG_DENSE_ENABLED=true
TALOS_RAG_SPARSE_ENABLED=true
TALOS_RAG_RRF_K=60
TALOS_RAG_RERANK_ENABLED=true
TALOS_RAG_RERANK_ADAPTER=talos.retrieval:lexical_rerank
TALOS_RERANK_API_BASE=http://127.0.0.1
TALOS_RERANK_API_KEY_NAME=TALOS_UNUSED_LOCAL_RERANK_KEY
TALOS_RERANK_TIMEOUT_SECONDS=10
TALOS_RAG_EXPANSION_SYNONYMS=bug:error,defect;auth:authentication,login;db:database,postgres
TALOS_GUARDRAIL_BLOCK_MESSAGE=Sorry, my policies do not allow me to answer that
TALOS_GUARDRAIL_MAX_CUSTOM_ITEMS=100
TALOS_GUARDRAIL_MAX_CUSTOM_ITEM_CHARACTERS=200

TALOS_REPO_MAX_FILES=500
TALOS_REPO_MAX_FILE_BYTES=65536
TALOS_REPO_MAX_TOTAL_BYTES=2097152
TALOS_REPO_MAX_LINE_CHARACTERS=2000
TALOS_REPO_EXTENSIONS=.py,.ts,.tsx,.js,.jsx,.md,.rst,.txt,.json,.yaml,.yml,.toml,.css,.html

TALOS_TRACING_ENABLED=true
TALOS_USAGE_TRACKING_ENABLED=true
TALOS_TRACE_RETENTION_MAX_RUNS=500
TALOS_ALERT_WINDOW_RUNS=20
TALOS_ALERT_MINIMUM_RUNS=3
TALOS_ALERT_FAILURE_RATE_THRESHOLD=0.5
TALOS_ALERT_SLOW_RUN_MILLISECONDS=30000
TALOS_OTEL_EXPORTER_ENABLED=false
OTEL_SERVICE_NAME=talos-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.invalid:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
# Phase 11 evaluation limits and deterministic evaluator identity
TALOS_EVALUATION_MAX_CASES_PER_DATASET=100
TALOS_EVALUATION_MAX_INPUT_CHARACTERS=4000
TALOS_EVALUATION_MAX_EXPECTED_OUTPUT_CHARACTERS=4000
TALOS_EVALUATION_MAX_ATTEMPTS=2
TALOS_EVALUATOR_VERSION=exact-citation-v1
